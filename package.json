{
  "name": "threadwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "worker": "node --env-file-if-exists=.env agent/worker.mjs",
    "mcp": "node agent/mcp.mjs",
    "build": "vite build --config web/vite.config.js",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:codex": "node tests/codex-smoke.mjs",
    "format": "prettier --write server agent scripts tests web compose*.yaml package.json",
    "test:browser": "npm run build && node --test tests/browser.mjs",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "workers": "node --env-file-if-exists=.env scripts/workers.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "bcryptjs": "^3.0.2",
    "chrome-devtools-mcp": "1.11.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "3.9.10",
    "vite": "^7.2.0"
  }
}

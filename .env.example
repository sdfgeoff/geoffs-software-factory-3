# Run npm run setup to generate private values in .env.
ADMIN_USERNAME=admin
ADMIN_NAME=Admin
ADMIN_PASSWORD=
AGENT_SPARK_TOKEN=
AGENT_SAGE_TOKEN=
WEB_PORT=8082
COOKIE_SECURE=false
# Optional for worker containers: leave unset to use ChatGPT device login.
# OPENAI_API_KEY=
# Manual/custom worker configuration:
# AGENT_TOKEN=
# AGENT_VOLUME=custom
# THREADWORK_URL=http://server:3001

# Server-only Git credentials. Repositories reference the variable name in the UI.
# GITHUB_REPO_TOKEN=
# Server-only SSH directory; defaults to the launching user's ~/.ssh (read-only).
# SSH_DIR=/path/to/your/.ssh

# Public deployment origin used by conversation/message copy-link actions.
# PUBLIC_ORIGIN=https://threadwork.example.com
